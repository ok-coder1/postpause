{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "postpause",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "settings": {
    "subreddit": {
      "cooldownMinutes": {
        "type": "number",
        "label": "Cooldown duration (in minutes)",
        "defaultValue": 30
      }
    }
  },
  "dev": {
    "subreddit": "postpause_dev"
  }
}