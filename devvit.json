{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "postpause",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Temporarily mute user",
        "description": "Temporarily stop/mute the user from posting for a set amount of time.",
        "forUserType": "moderator",
        "location": ["comment", "post"],
        "endpoint": "/internal/menus/mute-user"
      },
      {
        "label": "Reset cooldown/unmute user",
        "description": "Reset the cooldown for a user or unmute them if they are currently muted.",
        "forUserType": "moderator",
        "location": ["comment", "post"],
        "endpoint": "/internal/menus/reset-cooldown-unmute"
      }
    ]
  },
  "forms": {
    "muteUser": "/internal/forms/mute-user-submit",
    "resetCooldownUnmute": "/internal/forms/reset-cooldown-unmute-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "settings": {
    "subreddit": {
      "cooldownMinutes": {
        "type": "number",
        "label": "Cooldown duration (in minutes)",
        "validationEndpoint": "/internal/settings/validate-cooldown",
        "defaultValue": 15
      },
      "removalMessage": {
        "type": "string",
        "label": "Removal message (use 'r/subredditName' and 'timeLeft' as placeholders)",
        "validationEndpoint": "/internal/settings/validate-removal-message",
        "defaultValue": "Your post in r/subredditName was removed. Please wait **timeLeft** before posting again."
      },
      "exemptApprovedUsers": {
        "type": "boolean",
        "label": "Exempt approved users from cooldown",
        "defaultValue": false
      },
      "flairsCooldown": {
        "type": "paragraph",
        "label": "Specific cooldowns for each flair (must be in the format \"flair: cooldown\" with a newline separating each of these)",
        "validationEndpoint": "/internal/settings/validate-flairs"
      }
    }
  },
  "dev": {
    "subreddit": "postpause_dev"
  }
}